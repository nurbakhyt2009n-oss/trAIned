GROQ_API_KEY=your_groq_api_key_here
# PostgreSQL connection string (Neon). Leave empty to use local SQLite.
DATABASE_URL=
# Long random string (16+ chars) that protects /api/admin/* (stats, report, backup). Empty = disabled.
ADMIN_TOKEN=
# Optional: override Groq models when Groq retires one (https://console.groq.com/docs/models)
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
